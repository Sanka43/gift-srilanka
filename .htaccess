<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    # Route all requests to the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable directory browsing
Options -Indexes
