APP_NAME="Gifts Sri Lanka"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=giftsrilanka
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@giftsrilanka.com"
MAIL_FROM_NAME="${APP_NAME}"

# Delivery & Shop Settings
DELIVERY_CHARGE=350
ALLOWED_DISTRICTS=Colombo

# Bank Transfer Details
BANK_NAME="NDB Bank"
BANK_BRANCH="Rathmalana"
BANK_ACCOUNT_NAME="Southern Turn Networks"
BANK_ACCOUNT_NUMBER="115511287806"

# PayHere Payment Gateway Settings
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=false
PAYHERE_CURRENCY=LKR

# Contact Settings
CONTACT_EMAIL=info@giftsrilanka.com
CONTACT_PHONE="071 202 0642 / 077 773 2569"
CONTACT_WHATSAPP="072 552 4212"
CONTACT_ADDRESS="Colombo, Sri Lanka"
GOOGLE_ANALYTICS_ID=

# Chat Settings
CHAT_GUEST_ENABLED=false
CHAT_GUEST_COOKIE_DAYS=7
CHAT_POLL_MS=5000

# Google Sign-In (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Maps (optional). Leave empty to use OpenStreetMap + OSRM; set keys to switch to Google.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
